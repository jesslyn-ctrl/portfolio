---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="filter" data-tag-filter role="group" aria-label="Filter projects by technology" hidden>
  <button type="button" data-tag="" aria-pressed="true">All</button>
  {tags.map((tag) => <button type="button" data-tag={tag} aria-pressed="false">{tag}</button>)}
</div>
<p class="empty" data-filter-status role="status"></p>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }
  .filter[hidden] {
    display: none;
  }
  button {
    font: inherit;
    font-size: 0.85rem;
    padding: 5px 13px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
  }
  button:hover {
    color: var(--text);
    border-color: var(--text-soft);
  }
  button[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  /* Phones: one swipeable row instead of a wall of chips above the projects. */
  @media (max-width: 640px) {
    .filter {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin: 0 -16px 24px;
      padding: 2px 16px;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 16px, #000 calc(100% - 24px), transparent);
      mask-image: linear-gradient(90deg, transparent, #000 16px, #000 calc(100% - 24px), transparent);
    }
    .filter::-webkit-scrollbar {
      display: none;
    }
    button {
      flex: none;
    }
  }
  .empty {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    margin: 0;
  }
</style>
